# Your Freshdesk subdomain: https://<FRESHDESK_DOMAIN>.freshdesk.com
FRESHDESK_DOMAIN=your-subdomain
# Profile picture -> Profile Settings -> "View API Key". Never commit the real key.
FRESHDESK_API_KEY=your-api-key
# Optional: redact emails/phone numbers in returned text (default: true)
MASK_PII=true
# Optional: max retries on 429/5xx (default: 3)
MAX_RETRIES=3
# Optional: point at the local mock instead of a real account (npm run mock)
# FRESHDESK_BASE_URL=http://localhost:4010/api/v2
