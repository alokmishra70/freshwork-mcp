{
  "server": {
    "name": "freshdesk-mcp",
    "version": "1.0.0",
    "transport": "stdio",
    "access": "read-only"
  },
  "auth": {
    "type": "api_key",
    "env": [
      "FRESHDESK_DOMAIN",
      "FRESHDESK_API_KEY"
    ]
  },
  "tools": [
    {
      "name": "list_tickets",
      "description": "List tickets, newest first by default. Use for browsing recent or recently-updated tickets. To filter by status, priority, tag or date ranges use search_tickets instead. Returns up to per_page tickets; has_more=true means request the next page.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "filter": {
            "description": "Freshdesk predefined filter. Omit for all non-deleted, non-spam tickets.",
            "type": "string",
            "enum": [
              "new_and_my_open",
              "watching",
              "spam",
              "deleted"
            ]
          },
          "updated_since": {
            "description": "ISO 8601 timestamp, e.g. 2025-01-31T00:00:00Z",
            "type": "string"
          },
          "order_by": {
            "default": "created_at",
            "type": "string",
            "enum": [
              "created_at",
              "due_by",
              "updated_at",
              "status"
            ]
          },
          "order_type": {
            "default": "desc",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "page": {
            "default": 1,
            "description": "Page number, starting at 1",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "per_page": {
            "default": 30,
            "description": "Results per page (max 100)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "order_by",
          "order_type",
          "page",
          "per_page"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_ticket",
      "description": "Get one ticket by id, including its description. Set include_conversations to also fetch the reply/note thread.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Freshdesk ticket id"
          },
          "include_conversations": {
            "default": false,
            "description": "Also return the conversation thread (up to 10)",
            "type": "boolean"
          }
        },
        "required": [
          "ticket_id",
          "include_conversations"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "search_tickets",
      "description": "Search tickets by status, priority, tag, requester, assigned agent or date. All filters are combined with AND. Freshdesk caps search at 30 results/page and 10 pages (300 results total); narrow the filters if has_more stays true.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending",
              "resolved",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "tag": {
            "type": "string",
            "maxLength": 100
          },
          "requester_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "agent_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "created_after": {
            "description": "YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "created_before": {
            "description": "YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "updated_after": {
            "description": "YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "page": {
            "default": 1,
            "description": "Page 1-10",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "page"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_ticket_conversations",
      "description": "List the replies and notes on a ticket, oldest first. Private notes are flagged private_note=true.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Freshdesk ticket id"
          },
          "page": {
            "default": 1,
            "description": "Page number, starting at 1",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "per_page": {
            "default": 30,
            "description": "Results per page (max 100)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "ticket_id",
          "page",
          "per_page"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_contacts",
      "description": "List customer contacts, optionally filtered by exact email or updated_since.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "email": {
            "description": "Exact email match",
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "updated_since": {
            "description": "ISO 8601 timestamp",
            "type": "string"
          },
          "page": {
            "default": 1,
            "description": "Page number, starting at 1",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "per_page": {
            "default": 30,
            "description": "Results per page (max 100)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "page",
          "per_page"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_contact",
      "description": "Get one customer contact by id.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "contact_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "contact_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}
